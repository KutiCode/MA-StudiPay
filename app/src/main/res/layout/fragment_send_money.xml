<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    >

    <androidx.cardview.widget.CardView
        android:id="@+id/balance_card"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/orange"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- "Dein Guthaben" oben links -->
            <TextView
                android:id="@+id/balance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dein Guthaben:"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Geldbetrag darunter -->
            <TextView
                android:id="@+id/balance_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0 €"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <!-- Überschrift für Eingabe -->

    <!-- Eingabefeld für Betrag -->
    <TextView
        android:id="@+id/input_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Wie viel Geld möchtest du senden?"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/balance_card" />

    <androidx.cardview.widget.CardView
        android:id="@+id/amount_input_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/input_prompt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <EditText
                android:id="@+id/amount_input"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:hint="0"
                android:inputType="numberDecimal"
                android:gravity="center"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/euro_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="€"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Buttons für feste Beträge und Nummernfeld -->
    <GridLayout
        android:id="@+id/amount_buttons_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:columnCount="4"
        android:rowCount="4"
        android:alignmentMode="alignMargins"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/amount_input_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Feste Betragsbuttons -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_5_euro"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_margin="10dp"
            android:backgroundTint="@color/orange"
            app:cornerRadius="30dp"
            android:text="5€"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_15_euro"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/orange"
            app:cornerRadius="30dp"
            android:text="15€"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_25_euro"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/orange"
            app:cornerRadius="30dp"
            android:text="25€"
            android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_50_euro"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/orange"
            app:cornerRadius="30dp"
            android:text="50€"
            android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_7"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/black"
            app:cornerRadius="30dp"
            android:text="7"
            android:textColor="@color/white" />
        <!-- Erste Zeile des Nummernfelds -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_8"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/black"
            app:cornerRadius="30dp"
            android:text="8"
            android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_9"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/black"
            app:cornerRadius="30dp"
            android:text="9"
            android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_clear"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/orange"
            app:cornerRadius="30dp"
            android:text="AC"
            android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_4"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/black"
            app:cornerRadius="30dp"
            android:text="4"
            android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_5"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/black"
            app:cornerRadius="30dp"
            android:text="5"
            android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_6"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/black"
            app:cornerRadius="30dp"
            android:text="6"
            android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_comma"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/orange"
            app:cornerRadius="30dp"
            android:text=","
            android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_3"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/black"
            app:cornerRadius="30dp"
            android:text="3"
            android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_2"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/black"
            app:cornerRadius="30dp"
            android:text="2"
            android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_1"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/black"
            app:cornerRadius="30dp"
            android:text="1"
            android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button_0"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/orange"
            app:cornerRadius="30dp"
            android:text="0"
            android:textColor="@color/white" />

    </GridLayout>

    <!-- Weiter Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/continue_button"
        android:layout_width="133dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/green"
        android:text="Weiter"
        android:textColor="@color/white"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/amount_buttons_grid" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_settings_nav"
        android:layout_gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
