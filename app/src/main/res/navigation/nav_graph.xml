<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/welcomeFragment">

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.welcome.WelcomeFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_welcome" />

    <fragment
        android:id="@+id/senderSuccessFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.payment.SenderSuccessFragment"
        android:label="Sender Success"
        tools:layout="@layout/fragment_sender_success" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login" />

    <fragment
        android:id="@+id/registerFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.register.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/userInfoFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.settings.UserInfoFragment"
        android:label="User Info"
        tools:layout="@layout/fragment_user_info" />

    <fragment
        android:id="@+id/bankConnectionFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.bank.BankConnectionFragment"
        android:label="Bank Connection"
        tools:layout="@layout/fragment_bank_connection" />

    <fragment
        android:id="@+id/beginningRecieveFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.payment.BeginningReceiveFragment"
        android:label="Beginning Recieve"
        tools:layout="@layout/fragment_beginning_recieve" />

    <fragment
        android:id="@+id/beginningSendingFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.payment.BeginningSendingFragment"
        android:label="Beginning Sending"
        tools:layout="@layout/fragment_beginning_sending" />

    <fragment
        android:id="@+id/receivingHoldFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.payment.ReceivingHoldFragment"
        android:label="Receiving Hold"
        tools:layout="@layout/fragment_receiving_hold" />

    <fragment
        android:id="@+id/paymentSuccessFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.payment.SuccessPaymentFragment"
        android:label="Payment Success"
        tools:layout="@layout/fragment_success_payment" />

    <fragment
        android:id="@+id/paymentFailedFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.payment.FailedPaymentFragment"
        android:label="Payment Failed"
        tools:layout="@layout/fragment_failed_payment" />

    <fragment
        android:id="@+id/noWifiFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.payment.NoWifiFragment"
        android:label="No Wifi"
        tools:layout="@layout/fragment_no_wifi" />

    <fragment
        android:id="@+id/userTransactionFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.payment.UserTransactionFragment"
        android:label="User Transaction"
        tools:layout="@layout/fragment_user_transaction" />

    <fragment
        android:id="@+id/orangeDetailsFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.carddetails.OrangeDetailsFragment"
        android:label="Orange Details"
        tools:layout="@layout/fragment_orange_details" />

    <fragment
        android:id="@+id/userPinEntryFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.settings.UserPinEntryFragment"
        android:label="User Pin Entry"
        tools:layout="@layout/fragment_pin_entry" />

    <fragment
        android:id="@+id/bankSelectFragment"
        android:name="de.throsenheim.oektem.masterarbeit.ma_studipay.ui.view.bank.BankSelectFragment"
        android:label="Bank Select"
        tools:layout="@layout/fragment_bank_select" />

    <action
        android:id="@+id/action_settings_to_dashboard"
        app:destination="@id/dashboardFragment" />

    <action
        android:id="@+id/action_settingsFragment_to_loginFragment"
        app:destination="@id/loginFragment" />
    <action
        android:id="@+id/action_settingsFragment_to_welcomeFragment"
        app:destination="@id/welcomeFragment" />

    <action
        android:id="@+id/action_dashboardFragment_to_orangeDetailsFragment"
        app:destination="@id/orangeDetailsFragment" />

    <action
        android:id="@+id/action_dashboardFragment_to_userPinEntryFragment"
        app:destination="@id/userPinEntryFragment" />
    <action
        android:id="@+id/action_orangeDetailsFragment_to_dashboardFragment"
        app:destination="@id/dashboardFragment" />
    <action
        android:id="@+id/action_settingsFragment_to_UserInfoFragment"
        app:destination="@id/userInfoFragment" />
    <action
        android:id="@+id/action_UserInfoFragment_to_settingsFragment"
        app:destination="@id/settingsFragment" />
    <action
        android:id="@+id/action_settingsFragment_to_bankConnectionFragment"
        app:destination="@id/bankConnectionFragment" />
    <action
        android:id="@+id/action_BankConnectionFragment_to_settingsFragment"
        app:destination="@id/settingsFragment" />
    <action
        android:id="@+id/action_lastTransactionsFragment_to_orangeDetailsFragment"
        app:destination="@id/orangeDetailsFragment" />
    <action
        android:id="@+id/action_UserInfoFragment_to_userPinEntryFragment"
        app:destination="@id/userPinEntryFragment" />
    <action
        android:id="@+id/action_BankConnectionFragment_to_BankSelectionFragment"
        app:destination="@id/bankSelectFragment" />
    <action
        android:id="@+id/action_userPin_to_beginningRecieveFragment"
        app:destination="@id/beginningRecieveFragment" />
    <action
        android:id="@+id/action_welcomeFragment_to_loginFragment"
        app:destination="@id/loginFragment" />
    <action
        android:id="@+id/action_loginFragment_to_registerFragment"
        app:destination="@id/registerFragment" />
    <action
        android:id="@+id/action_loginFragment_to_dashboardFragment"
        app:destination="@id/dashboardFragment" />
    <action
        android:id="@+id/action_registerFragment_to_loginFragment"
        app:destination="@id/loginFragment" />
</navigation>
